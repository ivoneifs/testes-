# Copie este arquivo para .env e informe suas chaves.

# --- OpenAI (funções de IA) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# --- Supabase (login + banco). Deixe em branco para rodar SEM login. ---
# Painel do Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opcional: só se o backend precisar de escrita privilegiada (ignora RLS).
SUPABASE_SERVICE_ROLE_KEY=
